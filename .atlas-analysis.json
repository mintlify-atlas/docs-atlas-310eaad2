  "keyFeatures": [
    "Dual-role system supporting both clients (clientes) and barbers (barberos)",
    "Appointment request flow: clients can request citas directly with a barber or reserve pre-opened time slots",
    "Barber availability slot management: barbers open time slots that clients can reserve",
    "Full appointment lifecycle: pending → confirmed → completed, with cancel and reschedule support",
    "Star rating and review system for completed appointments",
    "Barber catalog with profile photos, specialties, pricing, and average ratings",
    "Interactive monthly calendar view for visualizing appointments and available slots",
    "Profile photo upload for both barbers and clients via Supabase Storage",
    "Supabase-powered backend with row-level security and stored procedures",
    "React Native/Expo mobile app with web support via Vercel"
  ],
  "publicApiSurface": [
    "POST /auth/register-client",
    "POST /auth/login",
    "GET /citas",
    "POST /citas/solicitar",
    "POST /citas/reservar",
    "PATCH /citas/:id/aceptar",
    "PATCH /citas/:id/rechazar",
    "PATCH /citas/:id/cancelar",
    "PATCH /citas/:id/reprogramar",
    "POST /citas/:id/calificar",
    "GET /slots",
